# Copy this file to ".env" and fill in the values from your Roblox OAuth 2.0 app
# (Creator Dashboard > OAuth 2.0 Apps). Never share or commit the real .env file.

ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=

# Must exactly match a Redirect URL registered on your OAuth app.
# Local testing:  http://localhost:3000/callback
# Hosted:         https://your-domain.com/callback
REDIRECT_URI=http://localhost:3000/callback

# Port the server listens on.
PORT=3000

# Optional. Address to listen on. Defaults to 127.0.0.1 for a localhost redirect, otherwise 0.0.0.0.
# HOST=

# Optional. Space-separated scopes. Must be a subset of the scopes ticked on your OAuth app.
# SCOPES=openid profile game-pass:read game-pass:write developer-product:read developer-product:write legacy-universe.badge:manage-and-spend-robux
